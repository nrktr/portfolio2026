---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Nicolas Rakotoary">
	<section class="contact-hero">
		<div class="wrap">
			<h1>
				<span class="rise">Shall we</span>
				<span class="serif rise" style="animation-delay:0.12s">meet</span><span
					class="rise"
					style="animation-delay:0.12s">?</span
				>
			</h1>

			<a href="mailto:nicolas@nicorako.com" class="contact-email reveal">
				<span class="contact-email-fill"></span>
				<span class="contact-email-text">nicolas@nicorako.com</span>
			</a>

			<div class="contact-details">
				<p class="reveal">Based in <strong>France</strong>, near <strong>Biarritz</strong> / <strong>Bayonne</strong>.</p>
				<p class="contact-time reveal">
					It's <strong id="local-time">--:--</strong> where I am right now <span class="dot"></span>
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.wrap {
		padding-left: max(0px, calc(35px - max(0px, calc((100vw - 1180px) / 2))));
	}
	.contact-hero {
		padding: 120px 0 140px;
	}
	.contact-hero h1 {
		font-family: var(--font-heading);
		font-size: clamp(40px, 5.2vw, 72px);
		line-height: 1.1;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin-bottom: 50px;
	}
	.contact-hero h1 .serif {
		position: relative;
		display: inline-block;
		font-family: 'Playfair Display', serif;
		font-style: italic;
		padding: 0.02em 0.18em;
	}
	.contact-hero h1 .serif::before {
		content: '';
		position: absolute;
		top: 16px;
		left: -1.5px;
		right: -1.5px;
		bottom: -1.5px;
		border: 1.5px solid var(--ink);
	}

	.contact-email {
		position: relative;
		display: inline-block;
		font-family: var(--font-heading);
		font-size: clamp(24px, 4.6vw, 48px);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		padding: 14px 26px;
		margin-bottom: 44px;
		box-shadow: inset 0 0 0 2px var(--ink);
		overflow: hidden;
	}
	.contact-email-fill {
		position: absolute;
		inset: -2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.25s ease-out;
	}
	.contact-email:hover .contact-email-fill {
		transform: scaleX(1);
	}
	.contact-email-text {
		position: relative;
		z-index: 1;
	}
	.contact-email:hover .contact-email-text {
		color: var(--ink-on-accent);
	}

	.contact-details {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.contact-details p {
		font-size: 19px;
		font-family: var(--font-body);
		color: var(--ink-soft);
		line-height: 1.5;
	}
	.contact-details strong {
		display: inline-block;
		color: var(--ink);
		font-weight: 600;
		border: 1px solid var(--ink);
		padding: 0.02em 0.28em;
	}
	.contact-time {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.dot {
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		animation: pulse 0.8s ease-in-out infinite;
	}
	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.35;
		}
	}
</style>

<script>
	import { initLocalTime } from '../scripts/localTime';

	initLocalTime('local-time');
</script>
