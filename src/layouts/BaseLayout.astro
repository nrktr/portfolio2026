---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	hidePortrait3D?: boolean;
}

const {
	title = 'Nicolas Rakotoary — Art Director & Motion Designer',
	description = 'Nicolas Rakotoary aka Nico Rako — art director & motion designer. Design studio based in France / Studio graphique basé au Pays Basque. More than 20 years crafting graphic design and motion for everyone, everywhere.',
	hidePortrait3D = false,
} = Astro.props;

const ogImageUrl = new URL('/images/og-image.jpg', Astro.site ?? Astro.url).toString();
// LinkedIn's unfurler (unlike Facebook/X, which flatten to a static first frame)
// keeps GIF animation when og:image points straight at a .gif — a static JPEG
// still covers every other platform via twitter:image below.
const ogImageAnimatedUrl = new URL('/images/og-image.gif', Astro.site ?? Astro.url).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const siteUrl = new URL('/', Astro.site ?? Astro.url).toString();

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Nicolas Rakotoary',
	alternateName: 'Nico Rako',
	jobTitle: 'Art Director & Motion Designer',
	description: 'Design studio based in France / Studio graphique basé au Pays Basque.',
	url: siteUrl,
	image: ogImageUrl,
	email: 'mailto:nicolas@nicorako.com',
	address: {
		'@type': 'PostalAddress',
		addressRegion: 'Pays Basque',
		addressCountry: 'FR',
	},
	areaServed: {
		'@type': 'Place',
		name: 'Worldwide',
	},
	sameAs: [
		'https://www.instagram.com/nicorakodotcom',
		'https://www.behance.net/nicorako',
		'https://www.linkedin.com/in/nicolas-rakotoary-784639128',
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Nicolas Rakotoary" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageAnimatedUrl} />
		<meta property="og:image:type" content="image/gif" />
		<meta property="og:image:width" content="640" />
		<meta property="og:image:height" content="360" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script is:inline>
			// Runs before first paint so a returning dark-mode visitor never sees a
			// flash of the light theme. Light stays the default: only an explicit
			// prior choice (localStorage) switches this on, never system preference.
			(function () {
				try {
					if (localStorage.getItem('theme') === 'dark') {
						document.documentElement.setAttribute('data-theme', 'dark');
					}
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<header>
			<div class="wrap">
				<div class="logo">
					<a href="/" class="logo-name"><span class="logo-name-fill"></span><span class="logo-name-text">Nicolas Rakotoary</span></a> <span class="logo-sub">is a creative person.</span>
				</div>
				{
					!hidePortrait3D && (
						<div id="header-3d-wrap" class="header-3d-wrap">
							<model-viewer
								id="header-3d"
								class="header-3d-model"
								src="/images/portraits/portrait - nico - 3D - v2.glb"
								alt="A 3D portrait of Nicolas Rakotoary that follows your cursor"
								camera-orbit="0deg 75deg 105%"
								disable-zoom
								interaction-prompt="none"
								shadow-intensity="0"
							/>
						</div>
					)
				}
				<nav>
					<ul>
						<li>
							<a href="/#showreel" class="nav-link">
								<span class="nav-link-track">
									<span class="nav-link-text">Reel</span>
									<span class="nav-link-text" aria-hidden="true">Reel</span>
								</span>
							</a>
						</li>
						<li>
							<a href="/#work" class="nav-link">
								<span class="nav-link-track">
									<span class="nav-link-text">Work</span>
									<span class="nav-link-text" aria-hidden="true">Work</span>
								</span>
							</a>
						</li>
						<li>
							<a href="/about" class="nav-link">
								<span class="nav-link-track">
									<span class="nav-link-text">About</span>
									<span class="nav-link-text" aria-hidden="true">About</span>
								</span>
							</a>
						</li>
						<li>
							<a href="/contact" class="nav-link">
								<span class="nav-link-track">
									<span class="nav-link-text">Contact</span>
									<span class="nav-link-text" aria-hidden="true">Contact</span>
								</span>
							</a>
						</li>
					</ul>
				</nav>
				<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode">
					<svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
					</svg>
					<svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
				</button>
			</div>
		</header>

		<slot />

		<button id="back-to-top" aria-label="Back to top">
			<svg viewBox="0 0 10 10"><polygon points="5,1 9,7 1,7" fill="#15171C"></polygon></svg>
		</button>

		<div id="custom-scrollbar" aria-hidden="true"></div>

		<footer>
			<div class="wrap">
				<div class="footer-contact">
					<p class="footer-cta">Let's have meaningful conversations.</p>
					<a href="mailto:nicolas@nicorako.com" class="email">
						<span class="email-fill"></span>
						<span class="email-text">nicolas@nicorako.com</span>
					</a>
				</div>
				<div class="socials">
					<div class="social-item">
						<span class="social-tooltip">Where I post illustrations and weird experiments.</span>
						<a href="https://www.instagram.com/nicorakodotcom" class="social-link" target="_blank" rel="noopener noreferrer">
							<span class="social-fill"></span>
							<span class="social-text">Instagram</span>
						</a>
					</div>
					<div class="social-item">
						<span class="social-tooltip">My creative content for... creatives.</span>
						<a href="https://www.behance.net/nicorako" class="social-link" target="_blank" rel="noopener noreferrer">
							<span class="social-fill"></span>
							<span class="social-text">Behance</span>
						</a>
					</div>
					<div class="social-item">
						<span class="social-tooltip">Where we all endure each other's AI ramblings.</span>
						<a href="https://www.linkedin.com/in/nicolas-rakotoary-784639128" class="social-link" target="_blank" rel="noopener noreferrer">
							<span class="social-fill"></span>
							<span class="social-text">LinkedIn</span>
						</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	/* ---------- NAV ---------- */
	header {
		position: sticky;
		top: 0;
		z-index: 30;
		background: var(--bg);
		padding: 28px 0;
		border-bottom: 1px solid var(--line);
	}
	header .wrap {
		position: relative;
		display: flex;
		justify-content: flex-end;
		align-items: center;
	}
	.logo {
		position: absolute;
		top: 50%;
		left: max(0px, calc(35px - max(0px, calc((100vw - 1180px) / 2))));
		transform: translateY(-50%);
		max-width: min(463px, calc(50vw - 127px));
		font-family: var(--font-heading);
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.header-3d-wrap {
		position: absolute;
		top: -70px;
		left: 50%;
		width: 170px;
		height: 170px;
		pointer-events: none;
		opacity: 0;
		transform: translateX(-50%) translateY(-120px);
		transition: width 0.4s ease, height 0.4s ease, opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.header-3d-wrap.is-loaded {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}
	.header-3d-wrap.is-compact {
		width: 150px;
		height: 150px;
	}
	.header-3d-wrap::before {
		content: '';
		position: absolute;
		inset: 10px;
		border-radius: 50%;
		background: var(--accent);
		opacity: 0.6;
	}
	.header-3d-model {
		display: block;
		width: 100%;
		height: 100%;
		--poster-color: transparent;
		background-color: transparent;
	}
	.logo-name {
		position: relative;
		display: inline-block;
		vertical-align: bottom;
		padding: 0.05em 0.3em;
		margin: -0.05em -0.3em;
		overflow: hidden;
	}
	.logo-name-fill {
		position: absolute;
		inset: -2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.22s ease-out;
		z-index: 0;
	}
	.logo-name:hover .logo-name-fill {
		transform: scaleX(1);
	}
	.logo-name-text {
		position: relative;
		z-index: 1;
	}
	.logo-name:hover .logo-name-text {
		color: var(--ink-on-accent);
	}
	.logo-sub {
		display: inline-block;
		vertical-align: bottom;
		color: var(--ink-soft);
		font-weight: 400;
	}
	.logo-sub.enter {
		animation: logo-sub-enter 0.4s ease-out;
	}
	@keyframes logo-sub-enter {
		from {
			opacity: 0;
			transform: translateX(5px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}
	nav ul {
		display: flex;
		gap: 20px;
		list-style: none;
	}
	.nav-link {
		position: relative;
		display: inline-flex;
		align-items: flex-start;
		font-size: 18px;
		color: var(--ink-on-accent);
		background: var(--accent);
		padding: 0 12px;
		height: 34px;
		overflow: hidden;
		opacity: 1;
		transition: opacity 0.25s ease;
	}
	nav ul:hover .nav-link:not(:hover) {
		opacity: 0.4;
	}
	.theme-toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		margin-left: 20px;
		background: transparent;
		box-shadow: inset 0 0 0 1px var(--line);
		border: none;
		color: var(--ink);
		cursor: pointer;
		flex-shrink: 0;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.theme-toggle:hover {
		background: var(--accent);
		color: var(--ink-on-accent);
	}
	.theme-toggle-icon {
		position: absolute;
		width: 17px;
		height: 17px;
		transition: opacity 0.25s ease, transform 0.3s ease;
	}
	.theme-toggle-icon--sun {
		opacity: 1;
		transform: scale(1) rotate(0deg);
	}
	.theme-toggle-icon--moon {
		opacity: 0;
		transform: scale(0.5) rotate(-30deg);
	}
	:root[data-theme='dark'] .theme-toggle-icon--sun {
		opacity: 0;
		transform: scale(0.5) rotate(30deg);
	}
	:root[data-theme='dark'] .theme-toggle-icon--moon {
		opacity: 1;
		transform: scale(1) rotate(0deg);
	}
	.nav-link-track {
		display: flex;
		flex-direction: column;
		transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.nav-link-text {
		display: block;
		height: 34px;
		line-height: 34px;
	}
	.nav-link:hover .nav-link-track {
		transform: translateY(-34px);
	}

	/* ---------- FOOTER ---------- */
	footer {
		border-top: 1px solid var(--line);
		padding: 48px 0;
	}
	footer .wrap {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 16px;
	}
	.footer-contact {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
	}
	.footer-cta {
		font-size: 14px;
		color: var(--ink-soft);
	}
	footer .email {
		position: relative;
		display: inline-block;
		font-family: var(--font-heading);
		font-size: 20px;
		color: var(--ink);
		padding: 10px 18px;
		box-shadow: inset 0 0 0 1.5px var(--ink);
		overflow: hidden;
	}
	.email-fill {
		position: absolute;
		inset: -2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.22s ease-out;
	}
	footer .email:hover .email-fill {
		transform: scaleX(1);
	}
	.email-text {
		position: relative;
		z-index: 1;
	}
	footer .email:hover .email-text {
		color: var(--ink-on-accent);
	}
	.socials {
		display: flex;
		align-items: flex-end;
		gap: 12px;
		font-size: 13px;
	}
	.social-item {
		position: relative;
	}
	.social-tooltip {
		position: absolute;
		bottom: 100%;
		right: 0;
		margin-bottom: 10px;
		width: max-content;
		max-width: 220px;
		font-size: 14px;
		line-height: 1.4;
		color: var(--ink-soft);
		text-align: right;
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 0.2s ease, transform 0.2s ease;
		pointer-events: none;
	}
	.social-item:hover .social-tooltip {
		opacity: 1;
		transform: translateY(0);
	}
	.social-link {
		position: relative;
		display: inline-block;
		color: var(--ink);
		padding: 8px 14px;
		box-shadow: inset 0 0 0 1.5px var(--ink);
		overflow: hidden;
	}
	.social-fill {
		position: absolute;
		inset: -2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.22s ease-out;
	}
	.social-link:hover .social-fill {
		transform: scaleX(1);
	}
	.social-text {
		position: relative;
		z-index: 1;
	}
	.social-link:hover .social-text {
		color: var(--ink-on-accent);
	}

	@media (max-width: 760px) {
		header .wrap {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: flex-start;
			align-items: center;
			row-gap: 18px;
			column-gap: 8px;
			padding-left: 35px;
		}
		.header-3d-wrap {
			display: none;
		}
		.logo {
			position: static;
			transform: none;
			max-width: none;
			font-size: 16px;
			flex: 1 0 100%;
		}
		/* Promote the <ul> and its <li>s into header .wrap's own flex-wrap
		   context so the theme toggle can share the last line with the nav
		   links instead of always being pushed onto its own row. */
		nav,
		nav ul {
			display: contents;
		}
		.theme-toggle {
			margin-left: 0;
		}
	}

	/* ---------- BACK TO TOP ---------- */
	#back-to-top {
		position: fixed;
		top: 50vh;
		right: 0;
		transform: translateY(-50%);
		width: 96px;
		height: 96px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--accent);
		border: none;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease, transform 0.2s ease;
		z-index: 10;
	}
	#back-to-top.visible {
		opacity: 1;
		pointer-events: auto;
	}
	#back-to-top:hover {
		transform: translateY(-50%) scale(1.06);
	}
	#back-to-top svg {
		width: 28px;
		height: 28px;
	}
	@media (max-width: 760px) {
		#back-to-top {
			top: auto;
			bottom: 20px;
			right: 16px;
			transform: none;
			width: 48px;
			height: 48px;
		}
		#back-to-top:hover {
			transform: scale(1.06);
		}
		#back-to-top svg {
			width: 14px;
			height: 14px;
		}
	}

	/* ---------- CUSTOM SCROLLBAR ---------- */
	#custom-scrollbar {
		position: fixed;
		top: 0;
		right: 0;
		width: 20px;
		background: var(--accent);
		border-radius: 0;
		opacity: 0;
		cursor: grab;
		transition: opacity 0.3s ease;
		z-index: 100;
	}
	#custom-scrollbar.visible {
		opacity: 1;
	}
	#custom-scrollbar.dragging {
		cursor: grabbing;
		transition: none;
	}
</style>

<script>
	// Landing on a page with a URL fragment (e.g. following the "Reel" link
	// from another page to "/#showreel") is handled entirely below, with our
	// own mobile-aware centering offset. The browser's native fragment jump
	// would otherwise land at the raw element top and can re-fire as late-
	// loading content (like the showreel iframe) shifts the layout, clobbering
	// our correction — so the fragment is stripped from the URL immediately,
	// before the browser acts on it, and restored once we've scrolled.
	const initialHashId = window.location.hash ? window.location.hash.slice(1) : null;
	if (initialHashId) {
		history.replaceState(null, '', window.location.pathname + window.location.search);
	}

	// Theme toggle: light stays the default on every first visit (no
	// prefers-color-scheme check), dark only ever turns on from an explicit
	// click, persisted in localStorage. The inline <head> script already
	// applied any stored choice before paint — this just wires the button.
	const themeToggle = document.getElementById('theme-toggle');
	function updateThemeToggleLabel() {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
	}
	updateThemeToggleLabel();
	themeToggle?.addEventListener('click', () => {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		if (isDark) {
			document.documentElement.removeAttribute('data-theme');
			try {
				localStorage.setItem('theme', 'light');
			} catch (e) {}
		} else {
			document.documentElement.setAttribute('data-theme', 'dark');
			try {
				localStorage.setItem('theme', 'dark');
			} catch (e) {}
		}
		updateThemeToggleLabel();
	});

	// Only pull in @google/model-viewer (a sizeable WebGL/three.js bundle) on
	// pages that actually render the 3D portrait — pages with `hidePortrait3D`
	// don't have the element at all, so skip loading and running this entirely.
	const header3d = document.getElementById('header-3d') as (HTMLElement & { cameraOrbit: string; loaded: boolean }) | null;
	if (header3d) {
		import('@google/model-viewer').then(() => {
			window.addEventListener(
				'pointermove',
				(e: PointerEvent) => {
					const nx = (e.clientX / window.innerWidth) * 2 - 1;
					const ny = (e.clientY / window.innerHeight) * 2 - 1;
					const azimuth = -nx * 50;
					const polar = 75 - ny * 25;
					header3d.cameraOrbit = `${azimuth.toFixed(2)}deg ${polar.toFixed(2)}deg 105%`;
				},
				{ passive: true }
			);

			const header3dWrap = document.getElementById('header-3d-wrap');
			const revealHeader3d = () => header3dWrap?.classList.add('is-loaded');
			if (header3d.loaded) {
				revealHeader3d();
			} else {
				header3d.addEventListener('load', revealHeader3d, { once: true });
			}
		});
	}

	const logoPhrases = [
		'is a creative person.',
		'is a freelancer.',
		'loves heavy music.',
		'was in rock bands.',
		'enjoys both Marvel and Nouvelle Vague films.',
		'has two kids.',
		'has a dry sense of humor.',
		'once went to Lapland.',
		'rides a skateboard.',
		'has 5 fishes.',
		'dreams of becoming a tattoo artist.',
		'sometimes is a DJ.',
		'once had a dog.',
		'once had a cat.',
	];
	let logoPhraseIndex = 0;
	const logoSubEl = document.querySelector<HTMLElement>('.logo-sub');

	const headerEl = document.querySelector<HTMLElement>('header');
	function setHeaderHeightVar() {
		if (!headerEl) return;
		document.documentElement.style.setProperty('--header-h', `${headerEl.offsetHeight}px`);
	}
	// Deferred a frame: reading offsetHeight immediately on script execution
	// forces a synchronous layout before stylesheets are guaranteed to be
	// applied yet (there's a CSS fallback value, so a frame of delay is fine).
	requestAnimationFrame(setHeaderHeightVar);
	window.addEventListener('resize', setHeaderHeightVar);

	setInterval(() => {
		if (!logoSubEl) return;
		logoPhraseIndex = (logoPhraseIndex + 1) % logoPhrases.length;
		logoSubEl.textContent = logoPhrases[logoPhraseIndex];
		logoSubEl.classList.remove('enter');
		void logoSubEl.offsetWidth;
		logoSubEl.classList.add('enter');
	}, 2500);

	function easeOutCubic(t: number) {
		return 1 - Math.pow(1 - t, 3);
	}

	function smoothScrollTo(targetY: number, duration = 700) {
		const startY = window.scrollY;
		const diff = targetY - startY;
		const startTime = performance.now();

		function step(now: number) {
			const elapsed = now - startTime;
			const progress = Math.min(elapsed / duration, 1);
			window.scrollTo(0, startY + diff * easeOutCubic(progress));
			if (progress < 1) requestAnimationFrame(step);
		}
		requestAnimationFrame(step);
	}

	const backToTop = document.getElementById('back-to-top');

	function toggleVisibility() {
		if (window.scrollY > window.innerHeight * 0.5) {
			backToTop?.classList.add('visible');
		} else {
			backToTop?.classList.remove('visible');
		}
	}

	toggleVisibility();

	backToTop?.addEventListener('click', () => {
		smoothScrollTo(0);
	});

	// No manual offset needed for most targets here: the "Work" target (the
	// filters bar) is sticky with its own top offset already accounting for
	// the header plus a gap, so it settles in the right place on its own
	// regardless of exactly where the scroll lands. The showreel gets a
	// manual centering offset on mobile.
	function computeScrollTargetY(id: string): number | null {
		const target = document.getElementById(id);
		if (!target) return null;
		const rect = target.getBoundingClientRect();
		let targetY = rect.top + window.scrollY;
		if (id === 'showreel' && window.matchMedia('(max-width: 760px)').matches) {
			targetY += rect.height / 2 - window.innerHeight / 2;
		}
		return targetY;
	}

	document.querySelectorAll<HTMLAnchorElement>('a[href^="/#"]').forEach((link) => {
		const id = link.getAttribute('href')!.slice(2);
		link.addEventListener('click', (e) => {
			const targetY = computeScrollTargetY(id);
			if (targetY === null) return;
			e.preventDefault();
			smoothScrollTo(targetY);
			history.pushState(null, '', `/#${id}`);
		});
	});

	// Landing directly on a page carrying a hash (e.g. following the "Reel"
	// link from another page) skips the click handler above, so the browser's
	// native fragment jump lands at the raw element top instead of our
	// adjusted position (e.g. the mobile showreel centering). Correct it once
	// layout has settled.
	if (initialHashId) {
		const id = initialHashId;
		// One frame is enough: target sections reserve their layout space via
		// CSS (e.g. the showreel's aspect-ratio box) rather than depending on
		// the iframe finishing its (possibly slow or blocked) network load, so
		// there's no need to wait for the 'load' event here.
		requestAnimationFrame(() => {
			const targetY = computeScrollTargetY(id);
			if (targetY !== null) window.scrollTo(0, targetY);
			history.replaceState(null, '', `${window.location.pathname}${window.location.search}#${id}`);
		});
	}

	const customScrollbar = document.getElementById('custom-scrollbar');
	let isDraggingScrollbar = false;

	function updateScrollbarThumb() {
		if (!customScrollbar) return;
		const doc = document.documentElement;
		const scrollableHeight = doc.scrollHeight - window.innerHeight;
		if (scrollableHeight <= 0) {
			customScrollbar.style.height = '0px';
			return;
		}
		const viewportRatio = window.innerHeight / doc.scrollHeight;
		const thumbHeight = Math.max(viewportRatio * window.innerHeight, 40);
		const trackHeight = window.innerHeight - thumbHeight;
		const scrollProgress = window.scrollY / scrollableHeight;
		customScrollbar.style.height = `${thumbHeight}px`;
		customScrollbar.style.top = `${scrollProgress * trackHeight}px`;
	}

	requestAnimationFrame(updateScrollbarThumb);
	window.addEventListener('resize', updateScrollbarThumb);

	let scrollbarIdleTimeout: ReturnType<typeof setTimeout>;
	function markScrolling() {
		updateScrollbarThumb();
		customScrollbar?.classList.add('visible');
		clearTimeout(scrollbarIdleTimeout);
		scrollbarIdleTimeout = setTimeout(() => {
			if (!isDraggingScrollbar) customScrollbar?.classList.remove('visible');
		}, 900);
	}

	// Both scroll handlers above read layout (scrollHeight) and write styles;
	// running them on every raw scroll event (which can fire far more often than
	// the display refresh rate) causes layout thrashing on long pages. Coalesce
	// to once per animation frame instead.
	let scrollTicking = false;
	window.addEventListener(
		'scroll',
		() => {
			if (scrollTicking) return;
			scrollTicking = true;
			requestAnimationFrame(() => {
				toggleVisibility();
				markScrolling();
				scrollTicking = false;
			});
		},
		{ passive: true }
	);

	customScrollbar?.addEventListener('mousedown', (e: MouseEvent) => {
		isDraggingScrollbar = true;
		customScrollbar.classList.add('dragging', 'visible');
		const startY = e.clientY;
		const startScroll = window.scrollY;
		const doc = document.documentElement;
		const scrollableHeight = doc.scrollHeight - window.innerHeight;
		const thumbHeight = customScrollbar.offsetHeight;
		const trackHeight = window.innerHeight - thumbHeight;

		function onMove(moveEvent: MouseEvent) {
			const deltaY = moveEvent.clientY - startY;
			const scrollDelta = trackHeight > 0 ? (deltaY / trackHeight) * scrollableHeight : 0;
			window.scrollTo(0, startScroll + scrollDelta);
		}
		function onUp() {
			isDraggingScrollbar = false;
			customScrollbar?.classList.remove('dragging');
			clearTimeout(scrollbarIdleTimeout);
			scrollbarIdleTimeout = setTimeout(() => customScrollbar?.classList.remove('visible'), 900);
			window.removeEventListener('mousemove', onMove);
			window.removeEventListener('mouseup', onUp);
		}
		window.addEventListener('mousemove', onMove);
		window.addEventListener('mouseup', onUp);
		e.preventDefault();
	});

	const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
	if (revealEls.length) {
		if ('IntersectionObserver' in window) {
			const revealObserver = new IntersectionObserver(
				(entries) => {
					// Elements that enter together still cascade in one after another.
					entries.filter((entry) => entry.isIntersecting).forEach((entry, i) => {
						const el = entry.target as HTMLElement;
						el.style.transitionDelay = `${i * 0.09}s`;
						el.classList.add('is-visible');
						revealObserver.unobserve(el);
					});
				},
				{ threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
			);
			revealEls.forEach((el) => revealObserver.observe(el));
		} else {
			revealEls.forEach((el) => el.classList.add('is-visible'));
		}
	}

	// Scrambles random characters into `text` over `duration`ms, revealing it
	// left to right (classic "decoder" glitch effect), then settles on the
	// real text for as long as the element stays in the DOM.
	const GLITCH_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
	function glitchRevealText(el: HTMLElement, text: string, duration = 1000) {
		const startTime = performance.now();
		let raf = 0;
		function frame(now: number) {
			const progress = Math.min((now - startTime) / duration, 1);
			const revealCount = Math.floor(progress * text.length);
			let out = '';
			for (let i = 0; i < text.length; i++) {
				const ch = text[i];
				if (i < revealCount || ch === ' ') {
					out += ch;
				} else {
					out += GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)];
				}
			}
			el.textContent = out;
			if (progress < 1) {
				raf = requestAnimationFrame(frame);
			}
		}
		raf = requestAnimationFrame(frame);
		return () => cancelAnimationFrame(raf);
	}

	// The framerate.tv embeds speak the Player.js postMessage protocol
	// (confirmed by sniffing their "ready" broadcast, which lists
	// addEventListener among its methods and "play" among its events).
	const PLAYER_JS_ORIGIN = 'https://framerate.tv';

	// Shows a "loading asset" label (glitch-revealed) + animated bar over a
	// video's container while the third-party player loads. The iframe's own
	// `load` event only means its document has loaded, well before the video
	// itself has decoded and started playing — so instead we subscribe to the
	// player's Player.js "play" event and dismiss on that instead, with a
	// timeout fallback in case the player never responds.
	function attachVideoLoadingBar(iframe: HTMLIFrameElement, label = 'loading - patience is key.') {
		const container = iframe.closest<HTMLElement>('.project-cover, .project-description-video, .showreel-media');
		if (!container) return;
		const bar = document.createElement('div');
		bar.className = 'video-loading-bar';
		const text = document.createElement('span');
		text.className = 'video-loading-text';
		bar.appendChild(text);
		container.appendChild(bar);
		const stopGlitch = glitchRevealText(text, label, 800);

		let dismissed = false;
		function dismiss() {
			if (dismissed) return;
			dismissed = true;
			stopGlitch();
			window.removeEventListener('message', onMessage);
			bar.classList.add('is-dismissing');
			let removed = false;
			const removeOnce = () => {
				if (removed) return;
				removed = true;
				bar.remove();
			};
			// transitionend is the normal path; the timeout is a safety net in
			// case it never fires (reduced-motion, a backgrounded tab, etc.).
			bar.addEventListener('transitionend', removeOnce, { once: true });
			setTimeout(removeOnce, 250);
		}

		const fallbackTimer = setTimeout(dismiss, 8000);

		function onMessage(e: MessageEvent) {
			if (e.source !== iframe.contentWindow) return;
			let data: unknown = e.data;
			if (typeof data === 'string') {
				try {
					data = JSON.parse(data);
				} catch {
					return;
				}
			}
			const message = data as { context?: string; event?: string };
			if (message?.context !== 'player.js') return;
			if (message.event === 'ready') {
				// Only now is the player actually listening for commands — sending
				// addEventListener any earlier (e.g. on the iframe's 'load', which
				// just means its document parsed, not that the player script has
				// initialized) risks the registration being silently dropped,
				// leaving the bar to linger until the fallback timeout even though
				// the video itself may already be visibly playing.
				iframe.contentWindow?.postMessage(
					JSON.stringify({ context: 'player.js', version: '1.0', method: 'addEventListener', value: 'play' }),
					PLAYER_JS_ORIGIN
				);
			} else if (message.event === 'play') {
				clearTimeout(fallbackTimer);
				dismiss();
			}
		}
		window.addEventListener('message', onMessage);
	}

	document
		.querySelectorAll<HTMLIFrameElement>(
			'.project-cover iframe[src], .project-description-video iframe[src], .showreel-media iframe[src]'
		)
		.forEach((iframe) => {
			const isShowreel = iframe.closest('.showreel-media') !== null;
			attachVideoLoadingBar(iframe, isShowreel ? 'LOADING SHOWREEL' : undefined);
		});

	// Embedded project videos (framerate.tv/Mux iframes with autoplay+loop) load
	// only once they're near the viewport, instead of all firing at once on
	// page load. Once loaded, the iframe is left alone for good: repeatedly
	// swapping its src to unload it (tried previously) broke the third-party
	// Mux player in Firefox (<media-controller> failed to upgrade, fetch
	// aborted mid-init) — not worth it just to stop an off-screen video
	// decoding in the background.
	const lazyVideoIframes = document.querySelectorAll<HTMLIFrameElement>('iframe[data-src]');
	if (lazyVideoIframes.length) {
		if ('IntersectionObserver' in window) {
			const lazyVideoObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const iframe = entry.target as HTMLIFrameElement;
						const dataSrc = iframe.dataset.src;
						if (dataSrc) {
							attachVideoLoadingBar(iframe);
							iframe.setAttribute('src', dataSrc);
						}
						observer.unobserve(iframe);
					});
				},
				{ rootMargin: '200px 0px' }
			);
			lazyVideoIframes.forEach((iframe) => lazyVideoObserver.observe(iframe));
		} else {
			lazyVideoIframes.forEach((iframe) => {
				const dataSrc = iframe.dataset.src;
				if (dataSrc) {
					attachVideoLoadingBar(iframe);
					iframe.setAttribute('src', dataSrc);
				}
			});
		}
	}
</script>
